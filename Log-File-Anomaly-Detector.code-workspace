{
  // VS Code Workspace File
  // Open with: code Log-File-Anomaly-Detector.code-workspace
  "folders": [
    {
      "name": "🔬 ML Engine (Flask)",
      "path": "./ml_engine"
    },
    {
      "name": "🌐 Web Dashboard (Django)",
      "path": "./web_dashboard"
    },
    {
      "name": "📁 Data",
      "path": "./data"
    },
    {
      "name": "📦 Project Root",
      "path": "."
    }
  ],
  "settings": {
    // Python formatting
    "editor.formatOnSave": true,
    "python.formatting.provider": "autopep8",
    "[python]": {
      "editor.defaultFormatter": "ms-python.autopep8"
    },
    // Tab size PEP8 standard
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    // File associations
    "files.associations": {
      "*.html": "html"
    },
    // Exclude noise from explorer
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/venv": true,
      "**/.venv": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.autopep8",
      "ms-python.pylint",
      "batisteo.vscode-django",
      "wholroyd.jinja",
      "streetsidesoftware.code-spell-checker"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "🔬 Flask ML Engine",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/app.py",
        "cwd": "${workspaceFolder}",
        "env": {
          "FLASK_ENV": "development",
          "FLASK_DEBUG": "True"
        },
        "console": "integratedTerminal"
      },
      {
        "name": "🌐 Django Dashboard",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/manage.py",
        "args": ["runserver", "8000"],
        "django": true,
        "console": "integratedTerminal"
      }
    ]
  }
}
