# =============================================================================
# .env.example — Environment Variable Template
# =============================================================================
# COPY this file to .env and fill in your values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
# =============================================================================

# --- Flask ML Engine ---
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False
FLASK_SECRET_KEY=change-this-to-a-random-string

# --- Django Dashboard ---
DJANGO_SECRET_KEY=change-this-to-another-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Flask API URL (used by Django to call the ML service) ---
FLASK_API_BASE_URL=http://127.0.0.1:5000

# --- Database (SQLite path, relative to web_dashboard/) ---
SQLITE_DB_PATH=db.sqlite3

# --- GitHub (Phase 2 — Dataset Download) ---
# Optional but STRONGLY recommended.
# Without a token: 60 API requests/hour (may hit limit during download).
# With a token:    5000 API requests/hour.
# Create one at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# --- Logging ---
LOG_LEVEL=INFO
